<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="willwright_category_sorting" resource="default" engine="innodb" comment="Category ranking snapshot and search publication queue">
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="smallint" name="availability" unsigned="true" nullable="false" default="2" comment="0 In Stock 1 Preorder 2 Unavailable"/>
        <column xsi:type="decimal" name="units_sold" precision="20" scale="4" unsigned="true" nullable="false" default="0" comment="Deprecated Unit Metric (No Longer Used)"/>
        <column xsi:type="decimal" name="sales_value" precision="20" scale="4" unsigned="true" nullable="false" default="0" comment="Net Paid Product Sales Value In Global Currency In Last 180 Days"/>
        <column xsi:type="smallint" name="rating" unsigned="true" nullable="false" default="0" comment="Approved Product Rating Percentage"/>
        <column xsi:type="boolean" name="needs_reindex" nullable="false" default="true" comment="Pending Search Publication"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="store_id"/><column name="product_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="WILLWRIGHT_CATEGORY_SORTING_PRODUCT" table="willwright_category_sorting" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="WILLWRIGHT_CATEGORY_SORTING_STORE" table="willwright_category_sorting" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="WILLWRIGHT_CATEGORY_SORTING_PENDING" indexType="btree"><column name="needs_reindex"/><column name="product_id"/></index>
    </table>
</schema>
